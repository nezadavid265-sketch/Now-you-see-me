# ════════════════════════════════════════════════════════════════════
#  Rivoshoppa environment configuration (example — contains NO secrets)
#  Copy to .env (`npm run setup` does this and generates random secrets).
# ════════════════════════════════════════════════════════════════════

# ── Core ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of the web app (used in emails and redirects)
APP_URL=http://localhost:5173
# Public URL where the API is reachable from the internet (payment callbacks)
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed browser origins (only needed when the
# frontend is served from a different origin than the API)
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the app (1 behind Nginx/Render/Railway)
TRUST_PROXY=0
LOG_LEVEL=info

# ── Database (PostgreSQL) ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5433/rivoshoppa?schema=public
# Development convenience: start a bundled PostgreSQL via `npm run db:start`
USE_EMBEDDED_POSTGRES=true
EMBEDDED_PG_PORT=5433
EMBEDDED_PG_PASSWORD=CHANGE_ME

# ── Authentication ──────────────────────────────────────────────────
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (HTTPS only)
COOKIE_SECURE=false
# Optional, e.g. .rivoshoppa.com when the API runs on api.rivoshoppa.com
COOKIE_DOMAIN=

# ── Background worker ───────────────────────────────────────────────
# Run the job worker inside the web process. Set false when running
# `npm run worker` as a separate process.
RUN_WORKER=true

# ── File storage ────────────────────────────────────────────────────
# local | s3  (use s3 on hosts with ephemeral disks: Render, Railway, Heroku…)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=auto
# For Cloudflare R2 / DigitalOcean Spaces / MinIO; leave blank for AWS
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket/CDN, e.g. https://cdn.rivoshoppa.com
S3_PUBLIC_BASE_URL=

# ── Email ───────────────────────────────────────────────────────────
# console (logs emails) | smtp
EMAIL_TRANSPORT=console
EMAIL_FROM="Rivoshoppa <no-reply@rivoshoppa.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── SMS ─────────────────────────────────────────────────────────────
# console | africastalking
SMS_PROVIDER=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ── Payments ────────────────────────────────────────────────────────
# Sandbox "test payment" method for development. Refused in production.
PAYMENT_TEST_MODE=true
TEST_WEBHOOK_SECRET=CHANGE_ME

# MTN MoMo Collection API (https://momodeveloper.mtn.com)
MOMO_ENABLED=false
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# sandbox | mtnrwanda (production value provided by MTN)
MOMO_TARGET_ENVIRONMENT=sandbox
# Sandbox only supports EUR; production Rwanda uses RWF
MOMO_CURRENCY=EUR
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=

# Airtel Money Africa Collection API (https://developers.airtel.africa)
AIRTEL_ENABLED=false
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=RW
AIRTEL_CURRENCY=RWF
# Optional: secret used to verify signed callbacks (if enabled on your Airtel app)
AIRTEL_CALLBACK_SECRET=

# ── Google Maps ─────────────────────────────────────────────────────
# Browser key (restrict to your domain + Maps JavaScript API & Geocoding API)
GOOGLE_MAPS_BROWSER_KEY=

# ── Development seed data ───────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@rivoshoppa.local
# Password used for all seeded development accounts
SEED_DEFAULT_PASSWORD=CHANGE_ME
